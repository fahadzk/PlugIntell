<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>com.core.docintel</groupId><artifactId>plugin-pipeline</artifactId><version>1.0.0</version><relativePath>../../pom.xml</relativePath></parent>
    <artifactId>ollama-answer-plugin</artifactId>
    <dependencies>
        <dependency><groupId>com.core.docintel</groupId><artifactId>pipeline-api</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>com.core.docintel</groupId><artifactId>ollama-plugin-support</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>dev.langchain4j</groupId><artifactId>langchain4j-ollama</artifactId><version>${langchain4j.ollama.version}</version></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    </dependencies>
    <build>
        <finalName>ollama-answer-plugin</finalName>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.2.4</version>
                <executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration>
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                    <filters><filter><artifact>*:*</artifact><excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude><exclude>META-INF/*.EC</exclude></excludes></filter></filters>
                    <artifactSet><excludes><exclude>com.core.docintel:pipeline-api</exclude></excludes></artifactSet>
                    <transformers><transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/></transformers>
                </configuration></execution></executions>
            </plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId></plugin>
        </plugins>
    </build>
</project>
